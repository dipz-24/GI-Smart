# ============================================================
# GI Smart — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it should stay in .gitignore.
# ============================================================

# ── PostgreSQL (Neon) — used by Prisma for auth data (users, sessions, accounts) ──
DATABASE_URL="postgresql://user:password@your-neon-host/dbname?sslmode=require"

# ── Better Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-a-generated-32-char-secret"

# Must match your actual running domain — localhost in dev, your real deployed
# URL in production (e.g. https://your-app.vercel.app). Mismatches here cause
# silent sign-up/sign-in failures.
BETTER_AUTH_URL="http://localhost:3000"

# Same rule as above — this gets baked into the client bundle at build time.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Neo4j (AuraDB) — foods, meal plans, tracking, recommendations ──
# From your Aura instance's downloaded credentials file.
# NOTE: some Aura instances use the instance ID as the username instead of
# the default "neo4j" — check your actual credentials file to confirm.
NEO4J_URI="neo4j+s://xxxxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="replace-with-your-aura-password"

# ── Anthropic API (optional — only needed if the chatbot feature is enabled) ──
ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"
